# =====================================================================
# UNIVERSAL PEST CONTROL — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your local or production values.
# NEVER commit the real .env file with production secrets.
# =====================================================================

# Server Settings
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=universal_pest_control
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_CONNECTION_LIMIT=10

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS Configuration
CORS_ORIGIN=*

# Future API Integrations (Phase 2+)
# META_APP_ID=
# META_APP_SECRET=
# META_ACCESS_TOKEN=
# WHATSAPP_API_KEY=
