# =====================================================================
# UNIVERSAL PEST CONTROL — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your local or production values.
# NEVER commit the real .env file with production secrets.
# =====================================================================

# Server Settings
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=universal_pest_control
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_CONNECTION_LIMIT=10

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS Configuration
CORS_ORIGIN=*

# Phase 6: Official WhatsApp Business / Cloud API Configuration
WHATSAPP_API_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token_here
WHATSAPP_MOCK_MODE=true

# Phase 7: Official Meta (Facebook & Instagram) Lead Ads Configuration
# Meta Graph API credentials (strictly backend only — never expose to frontend)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_meta_system_user_or_page_access_token_here
META_AD_ACCOUNT_ID=act_your_ad_account_id_here
META_PAGE_ID=your_facebook_page_id_here
META_WEBHOOK_VERIFY_TOKEN=your_meta_webhook_verify_token_here
META_MOCK_MODE=true

# Phase 9: Google Gemini AI Creative Content Generation (Server-Side Only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

